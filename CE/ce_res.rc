#include <windows.h>
#include "ce_resource.h"


/* App icon (16x16 + 32x32). IDI_APPICON (1) is this file's lowest-numbered
 * (and only) ICON resource, listed first, so it is the one the shell shows
 * for AppMain.exe; ce_main.c also puts it on the window class. Kept next
 * to the mascot in CE/icon/. */
IDI_APPICON  ICON    "icon/popsg.ico"

/* Main-menu mascot art blitted right of the "戻るキーでゲーム再開" hint by
 * MainMenuDlgProc's WM_PAINT (ce_main.c). CE/icon/popsg_mascot.bmp is
 * the "ohirune" mascot drawing (260x98) flattened onto the menu's cream
 * background (#F0E1BC) as 24bpp - this coredll has no TransparentBlt/
 * alpha blit, so the transparency is baked in (see ce_resource.h's
 * IDB_MAINMENU comment). windres resolves this path relative to this
 * .rc's own directory (CE/), where the Makefile runs it. */
IDB_MAINMENU BITMAP  "icon/popsg_mascot.bmp"


/* Touch-to-reveal "menu": plain DialogBoxW + PUSHBUTTON controls (see
 * ce_resource.h for why - this coredll doesn't export SetMenu). English
 * captions only: this .rc is compiled by windres and we have not
 * verified Japanese text survives that pipeline intact on this
 * toolchain, whereas the C-side wide string literals (MessageBoxW text
 * etc.) are confirmed working via \x-escaped UTF-16 - keep Japanese
 * strings there, not in resource scripts.
 *
 * Layout matches an earlier prototype's IDD_MAINMENU control-for-
 * control (same rects, same 210x140 size, ported per user request to be
 * "exactly the same"): Open ROM full width (WS_GROUP so Up/Down *wrap*
 * at the first/last button - see ce_resource.h), Save/Load State as a
 * 2-up row, the three config dialogs as a 3-up row in the same slot
 * the earlier prototype's Misc/Sound/Keys occupy, Exit full width, and a footer hint
 * line instead of a separate Resume/About button - resuming is just the
 * physical Back key (IDCANCEL), matching the earlier prototype exactly; there's no
 * equivalent slot for About in a 4-row layout, so it's gone too.
 * DS_CENTER dropped and WS_SYSMENU added (round 21, user request) to
 * match the earlier prototype's own dialogs pixel-for-pixel: positioned at its resource
 * x/y (0,0, i.e. the screen's top-left corner) instead of centered, with
 * a system "X" close box in the caption bar. That box isn't a dialog
 * control, so it never enters this dialog's physical-key focus chain;
 * tapping it delivers IDCANCEL the same way the physical Back key
 * already does (see MainMenuDlgProc's IDCANCEL case below), so no new
 * handling was needed for it to work.
 *
 * Same-row rects widened from a 4px gap to 8px (the menu redesign
 * notes' "~10px") for the pastel rounded-button skin - see
 * MainMenuDlgProc's WM_DRAWITEM/WM_ERASEBKGND (ce_main.c) and
 * kMainMenuTheme there for the actual colors/RoundRect() drawing.
 *
 * The Video/Sound/Input row grew from 20 to 34 tall (user request,
 * round 2 of this skin: give those three an icon-over-label 2-row
 * layout like the reference mockup, "it's fine if that row becomes
 * 2 lines") - Exit and the hint/mascot footer shifted down to match,
 * and the dialog's own height grew 140->154 to fit. Everything else
 * (widths, the 210 width, Open/Save/Load's row heights) is unchanged
 * from the confirmed-working-on-hardware layout; only this one row's
 * height and everything below it moved. The OS-drawn caption bar/frame
 * is not recolored - non-client area, same reasoning as
 * ApplyMainMenuLanguage()'s comment about not touching it for language
 * text. */
IDD_MAINMENU DIALOG 0, 0, 210, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSG"
FONT 9, "Tahoma"
BEGIN
    PUSHBUTTON "Open ROM...", IDC_MM_OPEN,       8,  8, 194, 20, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Save State",  IDC_MM_SAVESTATE,  8, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Load State",  IDC_MM_LOADSTATE, 109, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Video Cfg",   IDC_MM_VIDEO,      8, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Sound Cfg",   IDC_MM_SOUND,     75, 56,  60, 34, BS_OWNERDRAW
    PUSHBUTTON "Input Cfg",   IDC_MM_INPUT,    143, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Screenshot",  IDC_MM_SCREENSHOT, 8, 94,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Exit",        IDC_MM_EXIT,     109, 94,  93, 20, BS_OWNERDRAW
    LTEXT "Press Back to resume the game.", IDC_MM_HINT, 8, 122, 194, 20
END

/* Two columns (D-pad/Start on the left, A/B&1/A&2/X/Y/Z on the right,
 * both read top-to-bottom in that order - user request, round 22) of
 * label + remap-button pairs, plus a footer row - see ce_input.c for
 * the remap-by-press logic and ce_resource.h for why this is a plain
 * DialogBox like IDD_MAINMENU. The right column shows Genesis button
 * letters in their natural A/B/C/X/Y/Z order (see ce_input.c's
 * kInputOrder for the ctrlId each row binds - the retro/Genesis mapping
 * itself, and hence each row's default key, is unchanged, only which
 * row it appears in and, for two rows, its caption).
 *
 * Round 28 (user request): the Mode row is gone entirely (this device's
 * physical button budget doesn't stretch to a 7th remappable input, and
 * Mode has no Game Gear/Master System equivalent) - the left column is
 * now five rows (Up/Down/Left/Right/Start) instead of six, with Start
 * pulled up into the vacated y=92 slot; the right column's six rows are
 * untouched in position. Mode itself still works in-game (ce_input.c
 * keeps polling its default key), it's just no longer user-remappable
 * from this dialog - see ce_input.c's s_map/CtrlIdToIndex comments.
 * Also round 28: every label box is now a uniform 32 wide (was 14 for
 * the right column, 44 for the old Mode/Start rows) and every remap
 * button a uniform 48 wide (was 60 for Up/Down/Left/Right, 64 for the
 * right column) - the right column keeps the wider label box even
 * though its captions are back to plain single letters (round 29, user
 * request: round 28's "B&1"/"A&2" captions were reverted - see
 * ce_input.c's CeInputPoll for how the B/C-vs-Game-Gear-Button-1/2
 * relationship is now handled at the input level instead, not in the
 * dialog's text). Width
 * unified to 190 to match every other settings/picker dialog (user
 * request); height unchanged (the right column's six rows still set the
 * floor, same as before round 28's left-column trim). No Cancel button
 * - see IDD_SOUNDCONFIG's comment on why; WS_GROUP on the first remap
 * button makes Up/Down wrap through OK and back, same mechanism as
 * IDD_MAINMENU above. No Reset to Defaults button any more (round 21,
 * user request) - OK's size/position now matches every other dialog's
 * own OK (50x14, centered). DS_CENTER dropped and WS_SYSMENU added
 * (round 21) - see IDD_MAINMENU's comment above for why. */
/* 8 rows x 2 columns (round 30, user request: add PopSNES's
 * diagonal-combo buttons, grown from the previous 6-row layout to fit
 * them). Left column: Up/Down/Left/Right, then the four diagonal combos
 * (Up R/R Down/Down L/L Up - see ce_input.c's s_map idB field). Right
 * column: the same six Genesis buttons as before (A/B/C/X/Y/Z), then a
 * deliberately blank row where Select/Mode would go (round 28 dropped
 * its button from this dialog; round 30 kept it dropped rather than
 * reintroducing it - see ce_resource.h's IDC_IC_BTN_SELECT comment),
 * then Start moved down to the last row. Row spacing/button height
 * (17/14) match the sister PopSNES project's own
 * IDD_INPUTCONFIG so all 8 rows fit this dialog's existing 190x170
 * size without resizing it. */
IDD_INPUTCONFIG DIALOG 0, 0, 190, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Config"
FONT 9, "Tahoma"
BEGIN
    /* 2026-09-27 (PopPCE と同じ変更): remap buttons widened to 54 - the
     * Galmuri14 font's "Press key"/"Backspace" overflowed 48 on real
     * hardware (PopPCE). The dialog width is unchanged; the gaps between
     * the columns and the right margin were narrowed instead. */
    LTEXT     "Up",       IDC_IC_LBL_UP,      6,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UP,     40,  8, 54, 14, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    LTEXT     "A",        IDC_IC_LBL_A,      98,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_Y,     132,  8, 54, 14, BS_OWNERDRAW

    LTEXT     "Down",     IDC_IC_LBL_DOWN,    6, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWN,   40, 25, 54, 14, BS_OWNERDRAW
    LTEXT     "B",        IDC_IC_LBL_B,      98, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_B,     132, 25, 54, 14, BS_OWNERDRAW

    LTEXT     "Left",     IDC_IC_LBL_LEFT,    6, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFT,   40, 42, 54, 14, BS_OWNERDRAW
    LTEXT     "C",        IDC_IC_LBL_C,      98, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_A,     132, 42, 54, 14, BS_OWNERDRAW

    LTEXT     "Right",    IDC_IC_LBL_RIGHT,   6, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHT,  40, 59, 54, 14, BS_OWNERDRAW
    LTEXT     "X",        IDC_IC_LBL_X,      98, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_L,     132, 59, 54, 14, BS_OWNERDRAW

    LTEXT     "Up R",     IDC_IC_LBL_UPRIGHT,   6, 77, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UPRIGHT, 40, 76, 54, 14, BS_OWNERDRAW
    LTEXT     "Y",        IDC_IC_LBL_Y,        98, 77, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_X,      132, 76, 54, 14, BS_OWNERDRAW

    LTEXT     "R Down",   IDC_IC_LBL_RIGHTDOWN,  6, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHTDOWN,40, 93, 54, 14, BS_OWNERDRAW
    LTEXT     "Z",        IDC_IC_LBL_Z,          98, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_R,        132, 93, 54, 14, BS_OWNERDRAW

    LTEXT     "Down L",   IDC_IC_LBL_DOWNLEFT,   6,111, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWNLEFT, 40,110, 54, 14, BS_OWNERDRAW
    /* Right side of this row intentionally left blank - see the comment
     * above this dialog and ce_resource.h's IDC_IC_BTN_SELECT. Start
     * (below) sits half a row above where the regular 17-unit grid
     * would put it, splitting the difference between this blank slot
     * and its own row 8 - user request after round 30's real-hardware
     * check ("Startボタンの位置を半行上げしてほしい"). Only Start
     * moved; "L Up" on the left stays on the row-8 grid line, so the
     * two columns are no longer y-aligned on this last row. */
    LTEXT     "Start",    IDC_IC_LBL_START,    98,119, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_START,   132,118, 54, 14, BS_OWNERDRAW

    LTEXT     "L Up",     IDC_IC_LBL_LEFTUP,    6,128, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFTUP,   40,127, 54, 14, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",                IDOK,          70, 147,  50, 14, BS_OWNERDRAW
END

/* Volume/Rate/Bits/Quality are all "-/value/+" spinners now (ported
 * from an earlier prototype's own Sound Settings dialog, per user
 * request), not a COMBOBOX + RADIOBUTTON pairs - the value lives on a
 * WS_TABSTOP PUSHBUTTON in the middle so it gets a native focus
 * rectangle and a place in the physical-key Up/Down/Left/Right loop
 * (see ce_audio.c's SoundConfigDlgProc/SoundCtrlProc); the "-"/"+"
 * buttons on either side are touch-only (no WS_TABSTOP), matching
 * the earlier prototype's IDC_FRAMESKIP_MINUS/PLUS. The separate Mute checkbox is gone
 * too - Volume all the way down to 0 already silences output (same
 * design as the earlier prototype's Volume 0..10 replacing its old "No Sound" radio
 * choice), so a second, redundant control for the same thing didn't
 * carry over. No Cancel button: this device has no meaningful "discard
 * changes" gesture, only "go back" - the physical Back key (IDCANCEL)
 * commits and closes exactly like OK does (see SoundConfigDlgProc). This
 * dialog is now exactly 190x104, matching every settings/picker dialog
 * the earlier prototype has (Misc/Sound/Keys/ROM picker all share that footprint there
 * too) - same OK position (70,86,50,14) as this project's own Video
 * Config/ROM picker. DS_CENTER dropped and WS_SYSMENU added (round 21)
 * - see IDD_MAINMENU's comment above for why. */
IDD_SOUNDCONFIG DIALOG 0, 0, 190, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "Volume:",  IDC_SC_LBL_VOLUME,     8,  9, 44,  8
    PUSHBUTTON "-",        IDC_SC_VOLUME_MINUS,  53,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "10",       IDC_SC_VOLUME_VALUE,  68,  6, 20, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_VOLUME_PLUS,   89,  7, 14, 12, BS_OWNERDRAW

    LTEXT      "Rate:",    IDC_SC_LBL_RATE,       8, 26, 30,  8
    PUSHBUTTON "-",        IDC_SC_RATE_MINUS,    53, 24, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Native",   IDC_SC_RATE_VALUE,    68, 23, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_RATE_PLUS,    129, 24, 14, 12, BS_OWNERDRAW

    LTEXT      "Bits:",    IDC_SC_LBL_BITS,       8, 42, 30, 10
    PUSHBUTTON "-",        IDC_SC_BITS_MINUS,    45, 41, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16-bit",   IDC_SC_BITS_VALUE,    60, 40, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BITS_PLUS,    124, 41, 14, 12, BS_OWNERDRAW

    LTEXT      "Quality:", IDC_SC_LBL_QUALITY,    8, 59, 34, 10
    PUSHBUTTON "-",        IDC_SC_QUALITY_MINUS, 45, 58, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Smooth",   IDC_SC_QUALITY_VALUE, 60, 57, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_QUALITY_PLUS, 124, 58, 14, 12, BS_OWNERDRAW

    LTEXT      "Buffer:",  IDC_SC_LBL_BUFFER,     8, 76, 34, 10
    PUSHBUTTON "-",        IDC_SC_BUFFER_MINUS,  45, 75, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16 KB",    IDC_SC_BUFFER_VALUE,  60, 74, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BUFFER_PLUS,  124, 75, 14, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",    IDOK,                  70, 103, 50, 14, BS_OWNERDRAW
END

/* Scale (see CeScaleMode in ce_video.h for what each of the 4 modes
 * does), Transparency Effects, Frame Skip (a "-/value/+" spinner, same
 * reasoning as Sound Config's rows above), the English/Japanese toggle
 * (round 24: also a "-/value/+" spinner now, see ce_resource.h's
 * comment on IDC_VC_JAPANESE) and Enable Debug Logging (the Open Last
 * Folder checkbox was removed in round 74 - it is now always on, see
 * ce_fileopen.c) - this project's closest analogue to the earlier prototype's Misc
 * dialog. Scale was a 2x2 RADIOBUTTON grid until round 21 (user
 * request); now a single "-/value/+" spinner cycling through 4 states
 * displayed as x1/x1.5/Wide/Full (see ce_video.c's kScaleOrder/
 * kScaleLabels), same pattern as Frame Skip below and Sound Config's
 * Volume/Rate/Bits/Quality - one fewer row than the old grid, so the
 * dialog is shorter (116 vs. 130). No Cancel button - see
 * IDD_SOUNDCONFIG's comment above. Width unified to 190 like every
 * other settings/picker dialog. DS_CENTER dropped and WS_SYSMENU added
 * (round 21) - see IDD_MAINMENU's comment above for why. Round 25 (user
 * request) first moved IDC_VC_LANG_MINUS to the same x=45 as
 * IDC_VC_SCALE_MINUS above it and narrowed the value readout from 142
 * to 100; round 26 (user request, after seeing that on hardware)
 * abandoned matching Scale's x and instead centers the whole "-/value/
 * +" group horizontally within this dialog's own 190 width (unlike
 * Scale/Frame Skip above, which stay flush left under their own
 * "Scale:"/"Frame Skip:" captions - this row has no such caption to
 * stay flush with), and narrowed the value readout again, to 90 (both
 * "GAIKOKU-English" and "NIHON-Japanese" still fit - IDC_VC_JAPANESE is
 * one control shown at two different strings, not two controls, so
 * they're always exactly the same box). */
IDD_VIDEOCONFIG DIALOG 0, 0, 190, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT       "Scale:",       IDC_VC_LBL_SCALE,        8,  9, 30,  8
    PUSHBUTTON  "-",            IDC_VC_SCALE_MINUS,     45,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON  "x1",           IDC_VC_SCALE_VALUE,     60,  6, 40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_SCALE_PLUS,      101,  7, 14, 12, BS_OWNERDRAW

    /* BS_OWNERDRAW on a CHECKBOX collides with BS_CHECKBOX in the same
     * style field (both live in the low 4 bits windres treats as one
     * button-type value, not independent flags) and silently breaks
     * BM_GETCHECK/BM_SETCHECK/CheckDlgButton() - see the dev notes'
     * dialog-layout section. ce_video.c no longer trusts the system
     * check state for either checkbox below: it keeps its own bool
     * (s_noSpriteLimit / CeFileOpenGetRememberLast()) as the source of
     * truth and paints the box+check itself from WM_DRAWITEM via
     * CeBmpFontDrawOwnerCheckbox() (ce_bmpfont.c). */
    CHECKBOX    "No Sprite Limit", IDC_VC_TRANSPARENCY,  8, 24, 160, 12, BS_OWNERDRAW

    LTEXT       "Frame Skip:",  IDC_VC_LBL_FRAMESKIP,   8, 42,  90, 12
    PUSHBUTTON  "-",            IDC_VC_FRAMESKIP_DOWN, 100, 40,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "Off",          IDC_VC_FRAMESKIP_LABEL,116, 39,  26, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_FRAMESKIP_UP,   144, 40,  14, 12, BS_OWNERDRAW

    /* Round 26 (user request): this row's "-/value/+" group (total
     * width 14+2+90+2+14=122) is centred within the dialog's own 190
     * width - (190-122)/2=34 either side - rather than lining up with
     * any other row's column, since it has no leading caption of its
     * own to align under. The value readout (IDC_VC_JAPANESE) now
     * shows the actual language name ("English"/日本語) rather than the
     * old romaji pair, since it draws with the Shinonome bitmap font
     * (BS_OWNERDRAW, ce_bmpfont.c) instead of the OS-native font that
     * needed jptahoma.ttc to render Japanese - see ce_video.c's
     * UpdateLanguageLabel. */
    PUSHBUTTON  "-",              IDC_VC_LANG_MINUS,      34, 61,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "English",        IDC_VC_JAPANESE,        50, 60,  90, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",              IDC_VC_LANG_PLUS,      142, 61,  14, 12, BS_OWNERDRAW

    /* Enable Debug Logging: while unchecked (the default) CeLog() is a
     * no-op and no log file is created - see ce_log.h. Same BS_OWNERDRAW
     * checkbox pitfall as the Sprite Limit box above; ce_video.c keeps
     * s_debugLog as the source of truth and paints it via
     * CeBmpFontDrawOwnerCheckbox(). */
    CHECKBOX    "Enable Debug Logging", IDC_VC_DEBUGLOG, 8, 74, 160, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,                          70, 94, 50, 14, BS_OWNERDRAW
END

/* Custom ROM picker (see ce_fileopen.c) - replaces GetOpenFileNameW(),
 * ported to match an earlier prototype's own IDD_FILEOPEN/
 * DLGFileOpen as closely as possible (same field layout; WS_SYSMENU
 * added here, unlike this project's other dialogs, to match its "X"
 * close box - DS_CENTER kept from this project's own convention since
 * it's already proven reliable here, whereas the earlier prototype's version doesn't use
 * it). Folder-list + up-navigation ("<" as the first entry, not a real
 * file/folder) only, driven by the physical direction keys and the
 * decide/cancel keys - decide enters a folder or picks a file, cancel
 * goes up a folder or closes the picker at the root. Resized to 190x104
 * (from 200x130, user request) to match every settings/picker dialog
 * exactly, same OK position (70,86,50,14) as Sound/Video Config. */
IDD_FILEOPEN DIALOG 0, 0, 190, 108
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select ROM"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_FO_PATH, 6, 4, 178, 10
    /* Height trimmed 66 -> 64 (real-hardware lesson from the sister
     * PopNES / PopGB ports): at 66 the last row this box can
     * show came out partially clipped on real hardware. LBS_OWNERDRAWFIXED
     * (needed so CeBmpFontDrawTextW() can paint each row itself, same as
     * every other control here) requires LBS_HASSTRINGS alongside it or
     * LB_GETTEXT comes back empty. ce_fileopen.c's Left/Right paging
     * feature derives its own page size from whatever this height
     * actually resolves to in pixels at runtime (WM_MEASUREITEM's row
     * height), not from a fixed row count assumed here - the DLU-vs-
     * pixel mismatch made a hand-calculated row count unreliable on
     * real hardware. */
    /* 2026-09-27 (PopPCE と同じ変更): list 64 -> 68, dialog 104 -> 108,
     * OK 86 -> 90 - with the Galmuri14 font's 19px rows the 6th row came
     * out cut off on real hardware (PopPCE). */
    LISTBOX               IDC_FO_LIST, 6, 16, 178, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",   IDOK,        70, 90, 50, 14, BS_OWNERDRAW
END

/* Generic message box (see ce_resource.h's IDD_MSGBOX comment and
 * ce_main.c's CeShowMsgBox()/MsgBoxDlgProc). Use for any result message
 * that can carry Japanese text (MessageBoxW() can't - see
 * ce_resource.h). */
IDD_MSGBOX DIALOG 0, 0, 200, 64
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSG"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",     IDC_MB_TEXT, 8, 5, 184, 38
    DEFPUSHBUTTON "OK", IDOK,       75, 44, 50, 14, BS_OWNERDRAW
END

/* Yes/No confirmation (user request - Save State asks first). Copied
 * verbatim from the PopGB port's IDD_CONFIRM: same self-drawn
 * Shinonome-bitmap-font design as IDD_MSGBOX above; two BS_OWNERDRAW
 * buttons with custom IDs (IDC_CF_YES/IDC_CF_NO) drawn and key-handled
 * by ce_main.c's ConfirmDlgProc/ConfirmBtnCtrlProc. */
IDD_CONFIRM DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopSG"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",      IDC_CF_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "Yes", IDC_CF_YES, 18, 48, 45, 14, BS_OWNERDRAW
    PUSHBUTTON    "No",  IDC_CF_NO,  71, 48, 45, 14, BS_OWNERDRAW
END
